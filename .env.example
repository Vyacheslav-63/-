# Gemini API key (required for server-side RU <-> EN voice & text translation).
# Copy this file to ".env" for local development and set your real key.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Public URL of your deployed app (optional for local dev).
APP_URL="http://localhost:3000"

# Server port (defaults to 3000).
PORT="3000"

